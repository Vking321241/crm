# ============================================================
# DivaryTalk — Postgres próprio + auth própria. REQUIRED for login,
# /admin, CRM do cliente, arquivos e fluxo de instâncias WhatsApp.
# Self-hosted no seu VPS/EasyPanel — sem Supabase no runtime.
# ============================================================

# Main app database. A plain Postgres service — no RLS, no Supabase.
DATABASE_URL=postgres://user:password@host:5432/divarytalk

# Second, separate Postgres service used ONLY for file metadata
# (avatars/media) — kept apart from the main app database on
# purpose. Bytes live on a VPS disk volume; this DB stores paths.
STORAGE_DATABASE_URL=postgres://user:password@host:5432/divarytalk_storage

# Signs the session cookie (sessions.id) so a tampered cookie value
# is rejected before ever reaching the database. 64 hex chars = 32
# bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session (forces
# everyone to log in again) — do it deliberately, not accidentally.
SESSION_SECRET=your-64-char-hex-key-here

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# UAZAPI (the product's only WhatsApp transport — see
# src/lib/whatsapp/uazapi-client.ts). Server-wide deployment used to
# provision a new instance for every client the platform owner creates
# in /admin. UAZAPI_ADMIN_TOKEN is the *server* token (creates/lists
# instances) — never a per-instance token, which is generated per
# client and stored encrypted on whatsapp_instances.uazapi_token.
# Required — without these, /admin can't provision a client's WhatsApp
# instance at all.
UAZAPI_SERVER_URL=https://SEUSERVIDOR.uazapi.com
UAZAPI_ADMIN_TOKEN=your-uazapi-admin-token

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://talk.divary.com.br

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=pt-BR

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Shared secret protecting GET /api/cron/business-hours (checks
# `x-cron-secret` against this value). Generate any long random string:
#   openssl rand -hex 32
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ------------------------------------------------------------------
# Kiwify billing (optional — only needed for subscription checkout,
# webhook sync, and in-app cancellation; see src/lib/kiwify/)
# ------------------------------------------------------------------
# HMAC secret Kiwify signs webhook payloads with (src/app/api/kiwify/
# webhook). Set the SAME value here and in Kiwify's webhook config
# (Configurações → Webhooks → assinatura). Without it the webhook
# still runs but accepts unverified events — a spoofable way to
# grant/revoke subscription access.
# KIWIFY_WEBHOOK_SECRET=generate-a-long-random-string

# OAuth client credentials for Kiwify's Public API — used only by
# in-app "Cancelar assinatura" (POST /api/account/subscription/cancel)
# to call Kiwify's Subscriptions API on the owner's behalf. Generate
# these from Kiwify's API key screen; treat them as sensitive as a
# database password.
# KIWIFY_CLIENT_ID=
# KIWIFY_CLIENT_SECRET=
# KIWIFY_ACCOUNT_ID=

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20
